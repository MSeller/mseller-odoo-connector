<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_mseller" model="ir.ui.view">
        <field name="name">res.company.form.inherit.mseller</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MSeller e-CF" name="mseller_ecf" groups="base.group_system">
                    <group>
                        <group string="Connection">
                            <field name="mseller_environment"/>
                            <field name="mseller_email"/>
                            <field name="mseller_password" password="True"/>
                            <field name="mseller_api_key" password="True"/>
                        </group>
                        <group string="Cached Token">
                            <field name="mseller_id_token" readonly="1"/>
                            <field name="mseller_token_expiration" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_mseller_test_connection"
                            type="object"
                            string="Test Connection"
                            class="btn-primary"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
